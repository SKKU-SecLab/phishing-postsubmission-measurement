      "responseBodyPreview": "*{\r\n  padding:0;\r\n  margin:0;\r\n}\r\n#main{\r\n  max-width: 900px;\r\n  margin:0 auto;\r\n}\r\nheader{\r\n  background:#ffcc00;\r\n}\r\nheader .header{\r\n  padding: 14px 0px 15px 0px;\r\n}\r\nsection {\r\n  background-image: url(\"https://dhl-gohelp-dev.metadeploy.com/csr/en/static/media/infographic_background.ce90cb56.png\"), url(\"paper.gif\");\r\n}\r\n.step{\r\n  background:#ffcc00;\r\n}\r\n.step  span , .titre span{\r\n  font-size: 14px;\r\n  font-weight: 400;\r\n  display: list-item;\r\n  color:#fff;\r\n}\r\n.step ul li span{\r\n  background: #fff;\r\n  color:#ffcc00;\r\n  padding: 1px 6px;\r\n  text-align: center;\r\n  border-radius: 100%;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n}\r\n.step ul li .none{\r\n  color:#000308;\r\n  background:#ffcc00;\r\n  border: 1px solid #999999;\r\n}\r\n.step .n{\r\n  color:#000308;\r\n}\r\n.left .content{\r\n  font-size: 12px;\r\n}\r\n.left .contentt{\r\n  padding:0 40px;\r\n}\r\n.titre{\r\n  background:#bd0b06;\r\n}\r\n.billing label{\r\n  font-weight:700;\r\n}\r\n.form-control{\r\n  border: 1px solid #6c757d;\r\n}\r\n.billing form span{\r\n  font-size: 10px;\r\n}\r\n.billing .btn button{\r\n  FONT-SIZE: 15px;\r\n  BACKGROUND: #bd0b06;\r\n  padding:4px 15px;\r\n  border:none;\r\n  COLOR: #ffffff;\r\n}\r\n.free span{\r\n  font-size: 12px;\r\n  color:#CCCCCC;\r\n}\r\n.left h3{\r\n  color:#336;\r\n  font-size: 18px;\r\n}\r\nfooter{\r\n  background-image: url(\"https://assets.dpdhl-brands.com/guides/dhl/guides/design-basics/key-visuals/dhl-key-visuals-main-key-visuals-dhl-express.jpg\"), url(\"paper.gif\");\r\n}\r\n\r\nfooter .navv ul li , .footer-right span , footer p{\r\n font-size: 11px;\r\n color:#666;\r\n}\r\nfooter .footer-left{\r\n  border-right: 1px solid #CCCCCC;\r\n}\r\nfooter .bottom ul li{\r\n  display: inline-flex;\r\n  border-left: 1px solid #666;\r\n  font-size: 11px;\r\n  color:#666;\r\n  padding:0  5px;\r\n}\r\n.error{\r\n  color:red;\r\n  font-size: 11px;\r\n}\r\n@media(max-width:750px){\r\n  header , section , footer , section form{\r\n    padding:0 10px;\r\n  }\r\n  footer .footer-left{\r\n    border-right: none;\r\n  }\r\n  .step span{\r\n    font-size: 10px;\r\n  }\r\n  .left .contentt{\r\n    padding:0;\r\n  }\r\n}",
