      "responseBodyPreview": "@import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700;800&display=swap');\r\n\r\n*{\r\n  padding:0;\r\n  margin:0;\r\n  font-family: 'Open Sans', sans-serif;\r\n}\r\n.row{\r\n  padding-right:0;\r\n  padding-left: 0;\r\n}\r\n#main{\r\n  max-width: 1280px;\r\n  margin:0 auto;\r\n}\r\nheader{\r\n  position: fixed;\r\n  width:100%;\r\n}\r\nheader .header-top{\r\n  background:#323232;\r\n  color:#fff;\r\n}\r\nheader .header-top .navv ul li{\r\n  font-size: 10px;\r\n  padding: 12px 52px 9px 0!important;\r\n  font-weight:700;\r\n}\r\n.header{\r\n  background:#258900;\r\n}\r\n.header .ul ul li {\r\n  font-size: 1.1875rem;\r\n  color:#fff;\r\n}\r\n.apri , .search , .add{\r\n  background: url(\"../image/sprites.png\") no-repeat;\r\n  background-size: calc(152px / 2);\r\n  width: 21px;\r\n  height: 21px;\r\n  position: relative;\r\n  background-position-x: -42px;\r\n}\r\n.apri , .add{\r\n  margin-left: 8px;\r\n}\r\n.search{\r\n  background-position-x: -21px;\r\n  top:20px;\r\n}\r\n.add{\r\n  background-position-x: 0;\r\n}\r\n.header-right ul li{\r\n border-left: 1px solid #fff;\r\n padding:7px 28px;\r\n text-align: center;\r\n padding-top:25px;\r\n}\r\n.header-right li i{\r\n  color:#fff;\r\n  font-size: 25px;\r\n  font-weight:200;\r\n}\r\n.header-right ul li span{\r\n  color: #fff;\r\n  font-size: .625rem !important;\r\n  display: block;\r\n  padding-top: 5px;\r\n}\r\n.b-left{\r\n  background:#1d6300;\r\n}\r\n.head span{\r\n  color:#fff;\r\n  font-size: 10px;\r\n}\r\n\r\n\r\n\r\n/* _______ LOGIN _____ */\r\n\r\n.login{\r\n  background-image: url(\"../image/back.jpg\");\r\n  padding: 15px 0;\r\n  background-repeat: no-repeat;\r\n  background-position: center center;\r\n  height: 140vh;\r\n\r\n}\r\n.login .form , .login .reg{\r\n  padding-top:135px;\r\n  padding-left:60px;\r\n  padding-right: 60px;\r\n  max-width:415px;\r\n  background:#fff;\r\n  margin:0 auto;\r\n\r\n}\r\n.login .form h3{\r\n  color:#2b8804;\r\n}\r\n.login .form p{\r\n  color:#6F6F6F;\r\n  margin-left:7px;\r\n}\r\n.login .form a{\r\n  color: #258900;\r\n  font-size: .8125em;\r\n  font-weight:500;\r\n  text-decoration: none;\r\n}\r\n.login .form input , .cc form input{\r\n  border: 1px solid #323232;\r\n",
